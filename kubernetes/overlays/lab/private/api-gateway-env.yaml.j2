apiVersion: v1
kind: Secret
metadata:
  name: api-gateway-env
  namespace: openhvx
type: Opaque
stringData:
  NODE_ENV: "production"
  CORS_ORIGIN: "https://192.168.50.20"
  LOG_JSON: "1"
  LOG_LEVEL: "info"
  PORT: "8080"
  AUTH_URL: "http://auth:4000"
  CONTROLLER_URL: "http://controller:3000"
  BROKER_URL: "http://ws-broker:8081"
  INTERNAL_API_SECRET: {{ (secrets["INTERNAL_API_SECRET"]) | tojson }}
  ENABLE_APIDOCS: "false"
