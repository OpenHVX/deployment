apiVersion: v1
kind: Secret
metadata:
  name: controller-env
  namespace: openhvx
type: Opaque
stringData:
  NODE_ENV: "production"
  CORS_ORIGIN: "https://192.168.50.20"
  LOG_JSON: "1"
  LOG_LEVEL: "info"
  PORT: "3000"
  MONGO_URL: {{ ("mongodb://openhvx:" ~ secrets["mongo_password"] ~ "@mongo-0.mongo.openhvx.svc.cluster.local:27017,mongo-1.mongo.openhvx.svc.cluster.local:27017,mongo-2.mongo.openhvx.svc.cluster.local:27017/hvwm?replicaSet=rs0&authSource=admin&w=majority") | tojson }}
  RMQ_URL: {{ ("amqp://openhvx:" ~ secrets["rabbit_password"] ~ "@rabbitmq:5672/") | tojson }}
  AMQP_QUEUE_TYPE: "quorum"
  INTERNAL_API_SECRET: {{ (secrets["INTERNAL_API_SECRET"]) | tojson }}
  OUTBOX_ENCRYPTION_KEY: {{ (secrets["OUTBOX_ENCRYPTION_KEY"]) | tojson }}
  JWT_AGENT_SECRET: {{ (secrets["JWT_AGENT_SECRET"]) | tojson }}
  JWT_BROWSER_SECRET: {{ (secrets["JWT_BROWSER_SECRET"]) | tojson }}
  PUBLIC_WS_BASE: "wss://console.192-168-50-20.sslip.io/api"
  BROKER_WS_BASE: "wss://ws.192-168-50-20.sslip.io"
  STORAGE_CONTROLLER_AGENT_ID: "storage-controller-1"
  NETWORK_POC_ENABLED: {{ (settings.network_poc_enabled) | tojson }}
